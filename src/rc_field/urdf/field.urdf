  <link name="storage_blue"><inertial><mass value="6.600000"/><inertia ixx="0.550020" ixy="0" ixz="0" iyy="2.200020" iyz="0" izz="2.750000"/></inertial><visual><geometry><box size="2.0 1.0 0.006"/></geometry><material name="启动重试蓝"/></visual></link>
  <joint name="storage_blue_joint" type="fixed"><parent link="base_link"/><child link="storage_blue"/><origin xyz="4.5 5.0 0.012"/></joint>

<!-- ==================== 秘宝柱（地面层，共享区正北中心） ==================== -->
  
  <!-- 1. 秘宝底座（1000x1000mm，X轴居中，Y轴紧贴 L1 平台北侧边缘） -->
  <link name="mustika_pad"><inertial><mass value="3.300000"/><inertia ixx="0.275010" ixy="0" ixz="0" iyy="0.275010" iyz="0" izz="0.550000"/></inertial><visual><geometry><box size="1.0 1.0 0.006"/></geometry><material name="共享区米黄"/></visual></link>
  <joint name="mustika_pad_joint" type="fixed"><parent link="base_link"/><child link="mustika_pad"/><origin xyz="0 4.0 0.011"/></joint>
  
  <!-- 2. 秘宝柱身 -->
  <link name="mustika_pillar"><inertial><mass value="15.745270"/><inertia ixx="0.399766" ixy="0" ixz="0" iyy="0.399766" iyz="0" izz="0.143479"/></inertial><visual><geometry><cylinder radius="0.135" length="0.5"/></geometry><material name="柱身棕"/></visual><collision><geometry><cylinder radius="0.135" length="0.5"/></geometry></collision></link>
  <joint name="mustika_pillar_joint" type="fixed"><parent link="base_link"/><child link="mustika_pillar"/><origin xyz="0 4.0 0.25"/></joint>
  
  <!-- 3. 顶端秘宝金球 -->
  <link name="mustika_ball"><inertial><mass value="2.303835"/><inertia ixx="0.009215" ixy="0" ixz="0" iyy="0.009215" iyz="0" izz="0.009215"/></inertial><visual><geometry><sphere radius="0.1"/></geometry><material name="秘宝金"/></visual><collision><geometry><sphere radius="0.1"/></geometry></collision></link>
  <joint name="mustika_ball_joint" type="fixed"><parent link="base_link"/><child link="mustika_ball"/><origin xyz="0 4.0 0.6"/></joint>

  <!-- ==================== 地面共享区 天空块 5x5 棋盘格 (1200x1200mm) ==================== -->
  <link name="sky_pad"><inertial><mass value="4.752000"/><inertia ixx="0.570254" ixy="0" ixz="0" iyy="0.570254" iyz="0" izz="1.140480"/></inertial><visual><geometry><box size="1.2 1.2 0.006"/></geometry><material name="共享区米黄"/></visual></link>
  <joint name="sky_pad_joint" type="fixed"><parent link="base_link"/><child link="sky_pad"/><origin xyz="0 -4.2 0.011"/></joint>

