<?xml version="1.0"?>
<robot name="rc_field">

  <!-- ============================================================
       ABU Robocon 2027 竞赛场地  —  "追寻努桑塔拉秘宝"
       依据：官方规则手册 v1.0（图1、图2尺寸标注与官方 RGB 色表）
       单位：米。原点=场地正中心、地面高度(z=0)。X- 红方 / X+ 蓝方 / Z+ 向上。
       【对称性】全场 180° 中心旋转对称
       ============================================================ -->

  <!-- ==================== 官方调色板（RGB已除以255） ==================== -->
  <material name="红方地面">    <color rgba="0.941 0.824 0.824 1.0"/></material> <!-- 240,210,210 -->
  <material name="蓝方地面">    <color rgba="0.667 0.824 0.902 1.0"/></material> <!-- 170,210,230 -->
  <material name="共享区米黄">  <color rgba="0.961 0.941 0.784 1.0"/></material> <!-- 245,240,200 -->
  <material name="启动重试红">  <color rgba="0.875 0.133 0.133 1.0"/></material> <!-- 223,34,34 -->
  <material name="启动重试蓝">  <color rgba="0.196 0.000 1.000 1.0"/></material> <!-- 50,0,255 -->
  <material name="柱身棕">      <color rgba="0.392 0.243 0.000 1.0"/></material> <!-- 100,62,0 -->
  <material name="红方台面橙粉"><color rgba="0.922 0.706 0.627 1.0"/></material> <!-- 235,180,160 -->
  <material name="蓝方台面青蓝"><color rgba="0.588 0.843 0.863 1.0"/></material> <!-- 150,215,220 -->
  <material name="红方斜坡">    <color rgba="0.784 0.588 0.549 1.0"/></material> <!-- 200,150,140 -->
  <material name="蓝方斜坡">    <color rgba="0.510 0.706 0.784 1.0"/></material> <!-- 130,180,200 -->
  <material name="建塔位绿">    <color rgba="0.157 0.392 0.196 1.0"/></material> <!-- 40,100,50 -->
  <material name="红方交接橙">  <color rgba="0.961 0.667 0.235 1.0"/></material> <!-- 245,170,60 -->
  <material name="蓝方交接蓝">  <color rgba="0.235 0.667 0.961 1.0"/></material> <!-- 60,170,245 -->
  <material name="护栏灰">      <color rgba="0.745 0.745 0.725 1.0"/></material> <!-- 190,190,185 -->
  <material name="秘宝金">      <color rgba="0.855 0.647 0.125 1.0"/></material> <!-- 218,165,32 -->

  <!-- ==================== 基坐标 ==================== -->
  <link name="base_link"><inertial><mass value="0.001"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial></link>

  <!-- ==================== 地面层（11×11m） ==================== -->
  <link name="red_ground"><inertial><mass value="332.750000"/><inertia ixx="3355.231940" ixy="0" ixz="0" iyy="838.810065" iyz="0" izz="4194.036458"/></inertial><visual><geometry><box size="5.5 11.0 0.01"/></geometry><material name="红方地面"/></visual><collision><geometry><box size="5.5 11.0 0.01"/></geometry></collision></link>
  <joint name="red_ground_joint" type="fixed"><parent link="base_link"/><child link="red_ground"/><origin xyz="-2.75 0 0.005"/></joint>
  <link name="blue_ground"><inertial><mass value="332.750000"/><inertia ixx="3355.231940" ixy="0" ixz="0" iyy="838.810065" iyz="0" izz="4194.036458"/></inertial><visual><geometry><box size="5.5 11.0 0.01"/></geometry><material name="蓝方地面"/></visual><collision><geometry><box size="5.5 11.0 0.01"/></geometry></collision></link>
  <joint name="blue_ground_joint" type="fixed"><parent link="base_link"/><child link="blue_ground"/><origin xyz="2.75 0 0.005"/></joint>

  <!-- ==================== 场地边界木框 ==================== -->
  <link name="frame_south"><inertial><mass value="49.280000"/><inertia ixx="0.067349" ixy="0" ixz="0" iyy="515.166549" iyz="0" izz="515.181333"/></inertial><visual><geometry><box size="11.2 0.1 0.08"/></geometry><material name="柱身棕"/></visual><collision><geometry><box size="11.2 0.1 0.08"/></geometry></collision></link>
  <joint name="frame_south_joint" type="fixed"><parent link="base_link"/><child link="frame_south"/><origin xyz="0 -5.55 0.04"/></joint>
  <link name="frame_north"><inertial><mass value="49.280000"/><inertia ixx="0.067349" ixy="0" ixz="0" iyy="515.166549" iyz="0" izz="515.181333"/></inertial><visual><geometry><box size="11.2 0.1 0.08"/></geometry><material name="柱身棕"/></visual><collision><geometry><box size="11.2 0.1 0.08"/></geometry></collision></link>
  <joint name="frame_north_joint" type="fixed"><parent link="base_link"/><child link="frame_north"/><origin xyz="0 5.55 0.04"/></joint>
  <link name="frame_west"><inertial><mass value="49.280000"/><inertia ixx="515.166549" ixy="0" ixz="0" iyy="0.067349" iyz="0" izz="515.181333"/></inertial><visual><geometry><box size="0.1 11.2 0.08"/></geometry><material name="柱身棕"/></visual><collision><geometry><box size="0.1 11.2 0.08"/></geometry></collision></link>
  <joint name="frame_west_joint" type="fixed"><parent link="base_link"/><child link="frame_west"/><origin xyz="-5.55 0 0.04"/></joint>
  <link name="frame_east"><inertial><mass value="49.280000"/><inertia ixx="515.166549" ixy="0" ixz="0" iyy="0.067349" iyz="0" izz="515.181333"/></inertial><visual><geometry><box size="0.1 11.2 0.08"/></geometry><material name="柱身棕"/></visual><collision><geometry><box size="0.1 11.2 0.08"/></geometry></collision></link>
  <joint name="frame_east_joint" type="fixed"><parent link="base_link"/><child link="frame_east"/><origin xyz="5.55 0 0.04"/></joint>

  <!-- ==================== 中央分隔栏 ==================== -->
  <link name="divider_south"><inertial><mass value="6.600000"/><inertia ixx="3.445420" ixy="0" ixz="0" iyy="0.008800" iyz="0" izz="3.438380"/></inertial><visual><geometry><box size="0.04 2.5 0.12"/></geometry><material name="柱身棕"/></visual><collision><geometry><box size="0.04 2.5 0.12"/></geometry></collision></link>
  <joint name="divider_south_joint" type="fixed"><parent link="base_link"/><child link="divider_south"/><origin xyz="0 -4.25 0.06"/></joint>
  <link name="divider_north"><inertial><mass value="6.600000"/><inertia ixx="3.445420" ixy="0" ixz="0" iyy="0.008800" iyz="0" izz="3.438380"/></inertial><visual><geometry><box size="0.04 2.5 0.12"/></geometry><material name="柱身棕"/></visual><collision><geometry><box size="0.04 2.5 0.12"/></geometry></collision></link>
  <joint name="divider_north_joint" type="fixed"><parent link="base_link"/><child link="divider_north"/><origin xyz="0 4.25 0.06"/></joint>

  <!-- ==================== 启动区/地面重试区（700×700） ==================== -->
  <link name="start_red1"><inertial><mass value="1.617000"/><inertia ixx="0.066032" ixy="0" ixz="0" iyy="0.066032" iyz="0" izz="0.132055"/></inertial><visual><geometry><box size="0.7 0.7 0.006"/></geometry><material name="启动重试红"/></visual></link>
  <joint name="start_red1_joint" type="fixed"><parent link="base_link"/><child link="start_red1"/><origin xyz="-4.35 -5.15 0.011"/></joint>
  <link name="start_red2"><inertial><mass value="1.617000"/><inertia ixx="0.066032" ixy="0" ixz="0" iyy="0.066032" iyz="0" izz="0.132055"/></inertial><visual><geometry><box size="0.7 0.7 0.006"/></geometry><material name="启动重试红"/></visual></link>
  <joint name="start_red2_joint" type="fixed"><parent link="base_link"/><child link="start_red2"/><origin xyz="-5.15 -5.15 0.011"/></joint>
  <link name="start_blue1"><inertial><mass value="1.617000"/><inertia ixx="0.066032" ixy="0" ixz="0" iyy="0.066032" iyz="0" izz="0.132055"/></inertial><visual><geometry><box size="0.7 0.7 0.006"/></geometry><material name="启动重试蓝"/></visual></link>
  <joint name="start_blue1_joint" type="fixed"><parent link="base_link"/><child link="start_blue1"/><origin xyz="4.35 -5.15 0.011"/></joint>
  <link name="start_blue2"><inertial><mass value="1.617000"/><inertia ixx="0.066032" ixy="0" ixz="0" iyy="0.066032" iyz="0" izz="0.132055"/></inertial><visual><geometry><box size="0.7 0.7 0.006"/></geometry><material name="启动重试蓝"/></visual></link>
  <joint name="start_blue2_joint" type="fixed"><parent link="base_link"/><child link="start_blue2"/><origin xyz="5.15 -5.15 0.011"/></joint>

  <!-- ==================== 储存区（1000×2000） ==================== -->
  <link name="storage_red"><inertial><mass value="6.600000"/><inertia ixx="0.550020" ixy="0" ixz="0" iyy="2.200020" iyz="0" izz="2.750000"/></inertial><visual><geometry><box size="2.0 1.0 0.006"/></geometry><material name="启动重试红"/></visual></link>
