  <!-- ==================== L1 一级平台（6000×6000，高600mm） ==================== -->
  <link name="l1_body"><inertial><mass value="11880.000000"/><inertia ixx="35996.400000" ixy="0" ixz="0" iyy="35996.400000" iyz="0" izz="71280.000000"/></inertial><visual><geometry><box size="6.0 6.0 0.6"/></geometry><material name="护栏灰"/></visual><collision><geometry><box size="6.0 6.0 0.6"/></geometry></collision></link>
  <joint name="l1_body_joint" type="fixed"><parent link="base_link"/><child link="l1_body"/><origin xyz="0 0 0.3"/></joint>
  <link name="l1_top_red"><inertial><mass value="59.400000"/><inertia ixx="178.200178" ixy="0" ixz="0" iyy="44.550178" iyz="0" izz="222.750000"/></inertial><visual><geometry><box size="3.0 6.0 0.006"/></geometry><material name="红方台面橙粉"/></visual></link>
  <joint name="l1_top_red_joint" type="fixed"><parent link="base_link"/><child link="l1_top_red"/><origin xyz="-1.5 0 0.603"/></joint>
  <link name="l1_top_blue"><inertial><mass value="59.400000"/><inertia ixx="178.200178" ixy="0" ixz="0" iyy="44.550178" iyz="0" izz="222.750000"/></inertial><visual><geometry><box size="3.0 6.0 0.006"/></geometry><material name="蓝方台面青蓝"/></visual></link>
  <joint name="l1_top_blue_joint" type="fixed"><parent link="base_link"/><child link="l1_top_blue"/><origin xyz="1.5 0 0.603"/></joint>

<!-- ==================== 红方 L 型攀爬通道（最终版：纯实体斜坡包裹） ==================== -->
  
  <!-- 1. 红方交接区（中心点 Y=-1.3, 高0.6m） -->
  <link name="transfer_red_base"><inertial><mass value="330.000000"/><inertia ixx="37.400000" ixy="0" ixz="0" iyy="37.400000" iyz="0" izz="55.000000"/></inertial><visual><geometry><box size="1.0 1.0 0.6"/></geometry><material name="红方斜坡"/></visual><collision><geometry><box size="1.0 1.0 0.6"/></geometry></collision></link>
  <joint name="transfer_red_base_joint" type="fixed"><parent link="base_link"/><child link="transfer_red_base"/><origin xyz="-3.5 -1.3 0.30"/></joint>
  
  <link name="transfer_red"><inertial><mass value="4.400000"/><inertia ixx="0.366690" ixy="0" ixz="0" iyy="0.366690" iyz="0" izz="0.733333"/></inertial><visual><geometry><box size="1.0 1.0 0.008"/></geometry><material name="红方交接橙"/></visual></link>
  <joint name="transfer_red_joint" type="fixed"><parent link="base_link"/><child link="transfer_red"/><origin xyz="-3.5 -1.3 0.604"/></joint>

  <!-- 2. 红方台阶（包含3级） -->
  <link name="red_gstair3"><inertial><mass value="74.250000"/><inertia ixx="1.809844" ixy="0" ixz="0" iyy="7.440469" iyz="0" izz="6.744375"/></inertial><visual><geometry><box size="1.0 0.3 0.45"/></geometry><material name="红方台面橙粉"/></visual><collision><geometry><box size="1.0 0.3 0.45"/></geometry></collision></link>
  <joint name="red_gstair3_joint" type="fixed"><parent link="base_link"/><child link="red_gstair3"/><origin xyz="-3.5 -1.95 0.225"/></joint>
  
  <link name="red_gstair2"><inertial><mass value="49.500000"/><inertia ixx="0.742500" ixy="0" ixz="0" iyy="4.496250" iyz="0" izz="4.496250"/></inertial><visual><geometry><box size="1.0 0.3 0.30"/></geometry><material name="红方台面橙粉"/></visual><collision><geometry><box size="1.0 0.3 0.30"/></geometry></collision></link>
  <joint name="red_gstair2_joint" type="fixed"><parent link="base_link"/><child link="red_gstair2"/><origin xyz="-3.5 -2.25 0.15"/></joint>
  
  <link name="red_gstair1"><inertial><mass value="24.750000"/><inertia ixx="0.232031" ixy="0" ixz="0" iyy="2.108906" iyz="0" izz="2.248125"/></inertial><visual><geometry><box size="1.0 0.3 0.15"/></geometry><material name="红方台面橙粉"/></visual><collision><geometry><box size="1.0 0.3 0.15"/></geometry></collision></link>
  <joint name="red_gstair1_joint" type="fixed"><parent link="base_link"/><child link="red_gstair1"/><origin xyz="-3.5 -2.55 0.075"/></joint>

  <!-- 3. 红方斜坡（采用“厚截面沉地”法，制造完美实体三角形视觉） -->
  <!-- 尺寸 Z 从 0.03 加厚到 0.6。中心坐标依据三角函数同步位移，顶面保持原位不变 -->
